# 本地开发配置
# 复制此文件为 .env 并填入实际配置

# 阿里云DashScope API Key (从 https://dashscope.console.aliyun.com/ 获取)
DASHSCOPE_API_KEY=your_api_key_here

# Redis 配置
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# 阿里云函数计算配置 (可选，用于部署时)
ALIYUN_ACCOUNT_ID=your_account_id
VPC_ID=your_vpc_id
VSWITCH_ID=your_vswitch_id
SECURITY_GROUP_ID=your_security_group_id
